@page "/"
@inject GameEngine Engine
@inject HttpClient Http
@inject ILogger<Home> Log

<PageTitle>GraphLoot Engine - Interactive Visualization</PageTitle>

<div class="grid">
    <!-- Left: interactive graph -->
    <section class="panel graph-panel">
        <h2>World Graph</h2>
        <p class="hint">
            @if (_start is null) { <span>Click a node to set <b>start</b>.</span> }
            else if (_end is null) { <span>Start: <b>@_start</b>. Click another node to set <b>end</b>.</span> }
            else { <span>Start: <b>@_start</b> &rarr; End: <b>@_end</b>. Run to compute path.</span> }
        </p>

        @if (_graph is null || _graph.Nodes.Count == 0)
        {
            <div class="empty">
                <p>Loading graph data...</p>
                @if (_error is not null)
                {
                    <p style="color: #f85149;">Error: @_error</p>
                }
            </div>
        }
        else
        {
            <svg viewBox="@_viewBox" class="graph-svg" preserveAspectRatio="xMidYMid meet">
                <defs>
                    <filter id="edge-glow" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="3" result="blur"/>
                        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                    </filter>
                </defs>

                @* All edges (gray) *@
                @foreach (var e in GetUniqueEdges())
                {
                    <line x1="@F(e.A.X)" y1="@F(e.A.Y)" x2="@F(e.B.X)" y2="@F(e.B.Y)" class="edge" stroke-width="1.5" />
                    <g><text x="@F((e.A.X + e.B.X) / 2)" y="@F((e.A.Y + e.B.Y) / 2 - 5)" class="edge-label">@e.Weight.ToString("0.#")</text></g>
                }

                @* Path polyline drawn directly from ordered node positions *@
                @if (_traversal?.Path.Count > 1)
                {
                    var pts = string.Join(" ", _traversal.Path
                        .Select(n => _nodeByName.TryGetValue(n, out var nd) ? $"{F(nd.X)},{F(nd.Y)}" : null)
                        .Where(p => p != null));
                    @if (!string.IsNullOrEmpty(pts))
                    {
                        <polyline points="@pts" fill="none" stroke="#3b82f6" stroke-width="5"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  filter="url(#edge-glow)" />
                    }
                }

                @* Nodes *@
                @foreach (var n in _graph.Nodes.Values)
                {
                    var cls = "node";
                    if (n.Name == _start) cls += " node-start";
                    else if (n.Name == _end) cls += " node-end";
                    else if (_pathNodeSet.Contains(n.Name)) cls += " node-path";

                    <g class="@cls" @onclick="() => OnNodeClick(n.Name)" role="button" tabindex="0">
                        <circle cx="@F(n.X)" cy="@F(n.Y)" r="14" />
                        <text x="@F(n.X)" y="@F(n.Y + 28)" class="node-label">@n.Name</text>
                    </g>
                }
            </svg>

            <div class="legend">
                <span class="swatch start"></span> Start
                <span class="swatch end"></span> End
                <span class="swatch path"></span> On path
            </div>
        }
    </section>

    <!-- Right: controls + results -->
    <section class="panel controls-panel">
        <h2>Run</h2>

        <div class="controls">
            <label>
                Algorithm
                <select @bind="_algorithm">
                    <option value="dijkstra">Dijkstra</option>
                    <option value="astar">A*</option>
                </select>
            </label>

            <label>
                Simulation Runs
                <input type="number" min="1" max="100000" @bind="_runs" />
            </label>

            <div class="button-row">
                <button @onclick="RunPathfindingAsync"
                        disabled="@(_busy || _start is null || _end is null)">
                    Compute Path
                </button>

                <button @onclick="RunSimulationAsync" disabled="@_busy">
                    Run Simulation (×@_runs)
                </button>

                <button @onclick="ClearSelection" disabled="@_busy">Clear</button>
            </div>

            @if (_busy) { <div class="status">Running...</div> }
            @if (_error is not null) { <div class="error">@_error</div> }
        </div>

        @if (_traversal is not null)
        {
            <h3>Path Result</h3>
            @if (_traversal.Path.Count == 0)
            {
                <div class="error">No path found between the selected nodes.</div>
            }
            else
            {
            <div class="path-line">
                @string.Join(" → ", _traversal.Path)
            </div>
            <div style="font-size: 0.85em; color: #888; margin-top: 4px;">
                Path nodes: @string.Join(", ", _traversal.Path.Select(n => _nodeByName.ContainsKey(n) ? $"{n} ✓" : $"{n} ✗"))
            </div>

            @if (_traversal.Steps.Count > 0)
            {
                <h4>Steps</h4>
                <ol class="steps">
                    @foreach (var s in _traversal.Steps)
                    {
                        <li>@s.From → @s.To ✔</li>
                    }
                </ol>
            }
            }
        }

        @if (_simulation is not null)
        {
            <h3>Simulation Results</h3>
            <div class="sim-meta">
                @_simulation.Runs runs &middot; @_simulation.StepsPerRun.ToString("0.0") steps/run &middot;
                @_simulation.TotalLootRolls.ToString("N0") loot rolls
            </div>

            <h4>Rarity Distribution</h4>
            <BarChart Data="_simulation.RarityDistribution" />

            <h4>Weapon Type Distribution</h4>
            <BarChart Data="_simulation.WeaponDistribution" />
        }
    </section>
</div>

@code {
    private Graph? _graph;
    private Dictionary<string, NodeData> _nodeByName = new();
    private string _viewBox = "0 0 1000 1000";

    private string? _start;
    private string? _end;
    private string _algorithm = "dijkstra";
    private int _runs = 1000;

    private bool _busy;
    private string? _error;

    private TraversalOutput? _traversal;
    private SimulationResult? _simulation;

    private HashSet<string> _pathNodeSet = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load CSVs from wwwroot
            var nodesCsv = await Http.GetStringAsync("data/Nodes.csv");
            var mapCsv = await Http.GetStringAsync("data/DefaultMap.csv");
            var itemsCsv = await Http.GetStringAsync("data/Items.csv");

            Engine.LoadGraph(nodesCsv, mapCsv);
            Engine.LoadItems(itemsCsv);

            _graph = Engine.GetGraph();
            _nodeByName = new Dictionary<string, NodeData>(_graph.Nodes.Values.ToDictionary(n => n.Name));
            _viewBox = ComputeViewBox(_graph);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load data: {ex.Message}";
            Log.LogError(ex, "Failed to initialize engine");
        }
    }

    private void OnNodeClick(string name)
    {
        if (_start is null) { _start = name; return; }
        if (_end is null && name != _start) { _end = name; return; }
        _start = name;
        _end = null;
        _pathNodeSet.Clear();
        _traversal = null;
    }

    private void ClearSelection()
    {
        _start = null;
        _end = null;
        _traversal = null;
        _simulation = null;
        _error = null;
        _pathNodeSet.Clear();
    }

    private async Task RunPathfindingAsync()
    {
        if (_start is null || _end is null) return;
        _busy = true;
        _error = null;
        _simulation = null;
        _traversal = null;
        _pathNodeSet.Clear();

        try
        {
            _traversal = Engine.RunPathfinding(_start, _end, _algorithm);
            HighlightPath(_traversal.Path);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunSimulationAsync()
    {
        _busy = true;
        _error = null;
        _traversal = null;
        _simulation = null;
        _pathNodeSet.Clear();

        try
        {
            await Task.Run(() => _simulation = Engine.RunSimulation(_runs));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void HighlightPath(List<string> path)
    {
        _pathNodeSet = new HashSet<string>(path);
    }

    private List<(NodeData A, NodeData B, double Weight)> GetUniqueEdges()
    {
        var result = new List<(NodeData, NodeData, double)>();
        var drawn = new HashSet<string>();
        foreach (var kvp in _graph!.AdjList)
        {
            foreach (var edge in kvp.Value)
            {
                var canon = string.Compare(kvp.Key, edge.To, StringComparison.Ordinal) < 0
                    ? $"{kvp.Key}|{edge.To}" : $"{edge.To}|{kvp.Key}";
                if (!drawn.Add(canon)) continue;
                var a = _nodeByName.GetValueOrDefault(kvp.Key);
                var b = _nodeByName.GetValueOrDefault(edge.To);
                if (a is null || b is null) continue;
                result.Add((a, b, edge.Weight));
            }
        }
        return result;
    }

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string ComputeViewBox(Graph g)
    {
        if (g.Nodes.Count == 0) return "0 0 1000 1000";
        var nodes = g.Nodes.Values.ToList();
        var xs = nodes.Select(n => n.X).ToList();
        var ys = nodes.Select(n => n.Y).ToList();
        double minX = xs.Min() - 80, minY = ys.Min() - 80;
        double w = xs.Max() - xs.Min() + 160, h = ys.Max() - ys.Min() + 160;
        return $"{F(minX)} {F(minY)} {F(w)} {F(h)}";
    }
}
